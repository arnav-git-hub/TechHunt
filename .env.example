# TechHunt — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# Only NEXT_PUBLIC_* variables are safe to expose to the browser.

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── Application Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── URLs ─────────────────────────────────────────────────────────────────
FRONTEND_URL=
# This value is embedded in the browser bundle — keep it non-sensitive
NEXT_PUBLIC_API_BASE_URL=

# ── Environment ───────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false

# ── AI Provider (provider-agnostic — never expose to frontend) ────────────
OPENAI_API_KEY=

# ── OAuth — Future (not active in Stage 1) ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Stage 6 integrations (all optional; keep empty to disable) ───────────
SMTP_HOST=
SMTP_FROM_EMAIL=
SENTRY_DSN=
POSTHOG_API_KEY=

# ── Source Connector Keys — Only activate after credentials confirmed ─────
LUMA_API_KEY=
MEETUP_API_KEY=
